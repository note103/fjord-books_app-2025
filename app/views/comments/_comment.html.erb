<div id="<%= dom_id comment %>">
  <div>
    <%= simple_format(comment.body) %>
  </div>
  <div>
    <span>
      <%= comment.user.display_name %>
    </span>
    <span>
      <%= l(comment.created_at, format: :long) %>
    </span>
    <% if current_user == comment.user %>
      <%= button_to t('views.common.destroy', name: Comment.model_name.human.downcase), [comment.commentable, comment], method: :delete, data: { "turbo-confirm": t('views.common.delete_confirm') } %>
    <% end %>
  </div>
</div>
