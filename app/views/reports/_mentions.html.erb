<% if report.mentioned_reports.any? %>
  <div>
    <strong><%= t('activerecord.attributes.mention.mentioned_in', name: Report.model_name.human) %></strong>
    <ul>
      <% report.mentioning_reports.order(updated_at: :desc, id: :asc).each do |mentioning_report| %>
        <li>
          <%= link_to mentioning_report.title, report_path(mentioning_report) %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
