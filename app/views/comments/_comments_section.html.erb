<div>
  <div>
    <% commentable.comments.order(:created_at).each do |comment| %>
      <%= render comment %>
    <% end %>
  </div>
  <div>
    <%= form_with(model: [commentable, @comment || Comment.new]) do |form| %>

      <% if form.object.errors.any? %>
        <div style="color: red">
          <h2><%= t('views.common.validation_error', errors: i18n_error_count(form.object.errors.count), name: Comment.model_name.human.downcase) %>:</h2>
          <ul>
            <% form.object.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div>
        <%= form.label :body, style: "display: block" %>
        <%= form.text_area :body, required: true %>
      </div>
      <div>
        <%= form.submit %>
      </div>
    <% end %>
  </div>
</div>